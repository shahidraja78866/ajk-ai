# Copy this file to ".env" and fill in your own values. NEVER commit .env to git.
# NEVER put these values in frontend/Android code — server-side only.

# Your fal.ai API key (get it at https://fal.ai/dashboard/keys)
FAL_KEY=your_fal_api_key_here

# fal.ai text-to-video model id (verified against fal.ai's API docs;
# change to any fal text-to-video model you prefer)
FAL_MODEL=minimax/h3/text-to-video

# Model used for native-4K generations (Extra Pro plan). Defaults to the
# verified Kling O3 4K fal endpoint id (genuine native 4K, verified against
# fal.ai's API docs 2026-10-22). Override only if the provider changes it.
# FAL_MODEL_4K=fal-ai/kling-video/o3/4k/text-to-video

# Bootstrap admin account: the user who registers/logs in with this email
# gets admin access (Admin Panel at /admin, /api/admin/* endpoints).
# ADMIN_EMAIL=you@example.com

# Output resolution for the model (480P | 768P | 2K | 4K — lower is cheaper)
FAL_RESOLUTION=768P

# SQLite database file path (keep the default for v1)
DB_PATH=myvideoai.db

# A long random secret used to sign login tokens (generate your own)
JWT_SECRET=change_this_to_a_long_random_string

# Port the server listens on
PORT=8080

# The exact website origin allowed to call this API (your frontend URL)
FRONTEND_ORIGIN=http://localhost:3000

# Credits given to every new account
SIGNUP_CREDITS=10

# Max credits one user may spend per day (spending limit)
MAX_DAILY_CREDITS=20
