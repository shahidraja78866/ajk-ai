# Copy this file to ".env" and fill in your own values. NEVER commit .env to git.
# NEVER put these values in frontend/Android code — server-side only.

# Your fal.ai API key (get it at https://fal.ai/dashboard/keys)
FAL_KEY=your_fal_api_key_here

# fal.ai text-to-video model id (verified against fal.ai's API docs;
# change to any fal text-to-video model you prefer)
FAL_MODEL=minimax/h3/text-to-video

# Model used for native-4K generations (Extra Pro plan). Defaults to the
# verified Kling O3 4K fal endpoint id (genuine native 4K, verified against
# fal.ai's API docs 2026-10-22). Override only if the provider changes it.
# FAL_MODEL_4K=fal-ai/kling-video/o3/4k/text-to-video

# Model used for image-to-video generations (when the user uploads a
# starting image). Defaults to the verified MiniMax H3 image-to-video
# endpoint id (fal.ai API docs, verified 2026-10-23); the image is sent
# in the endpoint's documented `image_url` field.
# FAL_MODEL_I2V=minimax/h3/image-to-video

# Bootstrap admin account: the user who registers/logs in with this email
# gets admin access (Admin Panel at /admin, /api/admin/* endpoints).
# ADMIN_EMAIL=you@example.com

# Output resolution for the model (480P | 768P | 2K | 4K — lower is cheaper)
FAL_RESOLUTION=768P

# Base URL of the Google Translate web endpoint used to translate Urdu,
# Kashmiri, Arabic, Persian and Hindi prompts into English server-side
# (English/Chinese prompts are sent to the model as written). The default
# below is the production endpoint; override only for local testing.
# TRANSLATE_API_BASE=https://translate.googleapis.com

# SQLite database file path (keep the default for v1)
DB_PATH=myvideoai.db

# A long random secret used to sign login tokens (generate your own)
JWT_SECRET=change_this_to_a_long_random_string

# Port the server listens on
PORT=8080

# The exact website origin allowed to call this API (your frontend URL)
FRONTEND_ORIGIN=http://localhost:3000

# Credits given to every new account
SIGNUP_CREDITS=100

# Max credits one user may spend per day (spending limit)
MAX_DAILY_CREDITS=400

# Credit-pack payment destinations shown on the Buy Credits page (via
# /api/config -> payment_methods). Only the ones you set are shown; if none
# are set, the page says "Payment details will appear here soon."
# Buyers pay manually and submit the transaction ID; an admin verifies and
# approves in the Admin Panel before credits are granted.
# PAYMENT_EASYPAISA=03XX-XXXXXXX (Account Name)
# PAYMENT_JAZZCASH=03XX-XXXXXXX (Account Name)
# PAYMENT_NAYAPAY=yourid@nayapay (Account Name)
# PAYMENT_BANK=Bank Name — Account Title — IBAN

# --- Google Play Billing (automatic in-app purchases in the Android app) ---
# FAILS CLOSED: until BOTH values below are set, the Play verify endpoint
# returns 503 "billing_not_configured" and grants nothing. The product IDs
# themselves live on the plans/packs (Admin Panel, Google Play section of
# the README) and must match the products created in Play Console.
# The app's package name in Play Console (must match the published app):
# PLAY_PACKAGE_NAME=com.example.ajkai
# Service account with access to the Play Developer API — either a path to
# the service-account JSON file, or the JSON itself inline. Server-side
# only; NEVER commit the real value or ship it in the app.
# GOOGLE_PLAY_CREDENTIALS=/path/to/play-service-account.json
# Shared secret for the Real-Time Developer Notifications (Pub/Sub) push
# endpoint — the push URL must carry ?secret=<this value>. Optional but
# recommended; when unset the RTDN endpoint accepts unauthenticated pushes.
# PLAY_RTDN_SECRET=change_this_to_a_long_random_string

# --- PayFast payment gateway (automatic Easypaisa / JazzCash / cards / bank) ---
# FAILS CLOSED: until GATEWAY_PROVIDER and the merchant keys are set, the
# gateway checkout endpoint returns 503 "gateway_not_configured" and
# webhooks grant nothing. The merchant account requires the owner's own
# CNIC + bank-account KYC (see the README gateway section).
# GATEWAY_PROVIDER=payfast
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_NAME=
# PAYFAST_SECURED_KEY=
# Gateway API base URL. The default is PayFast's UAT host; replace with
# the production host shown in your merchant dashboard at go-live.
# PAYFAST_BASE_URL=https://ipguat.apps.net.pk
# Public base URL of THIS server, used to build gateway redirect/callback
# URLs. Derived from the request when unset; set it in production.
# PUBLIC_BASE_URL=https://ajk-ai.onrender.com

# TEST ONLY — never set these in production. PLAY_TEST_MODE=1 swaps the
# Play verifier for the token-keyed mock used by test.sh;
# GATEWAY_TEST_MODE=1 skips the gateway's real token-mint call.
# PLAY_TEST_MODE=
# GATEWAY_TEST_MODE=
